{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["openai"],
  "model": "openai/gpt-5.6-luna",
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-luna": {
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  },
  "lsp": true,
  "permission": {
    "external_directory": {
      "~/dev/**": "allow"
    }
  }${OPENCODE_WORK_CONFIG}
}
